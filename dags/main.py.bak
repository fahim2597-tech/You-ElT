from airflow import DAG
from airflow.decorators import task
from airflow.models import Variable
from datetime import timedelta
import pendulum
import requests
import json


default_args = {
    "owner": "dataengineer",
    "retries": 1,
    "retry_delay": timedelta(minutes=5),
}


MAX_RESULTS = 50


with DAG(
    dag_id="youtube_elt_pipeline",
    default_args=default_args,
    start_date=pendulum.datetime(2025,1,1,tz="UTC"),
    schedule="@daily",
    catchup=False,
    tags=["youtube","elt"],
) as dag:


    @task
    def get_playlist_id():

        api_key = Variable.get("API_KEY")
        channel_id = Variable.get("CHANNEL_HANDLE")

        url = "https://youtube.googleapis.com/youtube/v3/channels"

        params = {
            "part":"contentDetails",
            "id":channel_id,
            "key":api_key
        }

        r=requests.get(url,params=params)
        r.raise_for_status()

        return r.json()["items"][0]["contentDetails"]["relatedPlaylists"]["uploads"]


    @task
    def get_video_ids(playlist_id):

        api_key=Variable.get("API_KEY")

        url="https://youtube.googleapis.com/youtube/v3/playlistItems"

        ids=[]
        token=None

        while True:

            params={
                "part":"contentDetails",
                "playlistId":playlist_id,
                "maxResults":MAX_RESULTS,
                "key":api_key
            }

            if token:
                params["pageToken"]=token

            r=requests.get(url,params=params)
            r.raise_for_status()

            data=r.json()

            for x in data.get("items",[]):
                ids.append(x["contentDetails"]["videoId"])


            token=data.get("nextPageToken")

            if not token:
                break

        return ids


    @task
    def extract_video_data(video_ids):

        api_key=Variable.get("API_KEY")

        url="https://youtube.googleapis.com/youtube/v3/videos"

        output=[]

        for i in range(0,len(video_ids),50):

            batch=video_ids[i:i+50]

            params={
                "part":"snippet,statistics,contentDetails",
                "id":",".join(batch),
                "key":api_key
            }

            r=requests.get(url,params=params)
            r.raise_for_status()

            for item in r.json().get("items",[]):

                stats=item.get("statistics",{})

                output.append({
                    "Video_ID":item["id"],
                    "Video_Title":item["snippet"]["title"],
                    "Upload_Date":item["snippet"]["publishedAt"],
                    "Duration":item["contentDetails"]["duration"],
                    "Video_Views":int(stats.get("viewCount",0)),
                    "Likes_Count":int(stats.get("likeCount",0)),
                    "Comments_Count":int(stats.get("commentCount",0))
                })


        return output



    @task
    def save_json(data):

        import os

        path="/opt/airflow/data"
        os.makedirs(path, exist_ok=True)

        filename=os.path.join(path,"YT_data.json")

        with open(filename,"w",encoding="utf-8") as f:
            json.dump(data,f,indent=4,ensure_ascii=False)

        return filename



    playlist=get_playlist_id()

    ids=get_video_ids(playlist)

    data=extract_video_data(ids)

    save=save_json(data)

    ids >> data >> save
